# ─── Adjust for your environment ────────────────────────────────────
primary_region = "us-east-1"
environment    = "dev"
project_name   = "ses-email"
team_name      = "training"
cost_center    = "engineering"
compliance     = "internal"
github_org     = "darvin-rakotomalala"
github_repo    = "setting-up-aws-ses"
bucket_name    = "ce-dev-terraform-state-69127"

sender_email           = "darvintojo@gmail.com"
recipient_email        = "darvintojo@gmail.com" # defaults to sender_email
alarm_emails           = ["darvintojo@gmail.com"]
enable_waf             = false
waf_rate_limit         = 300
lambda_function_name   = "sesEmailBackend"
lambda_alias_name      = "lambda-dev"
lambda_memory_mb       = 1024
lambda_timeout_seconds = 30
# reserved_concurrency                       = 10
cold_start_strategy                        = "snapstart"
provisioned_concurrency_min                = 1
provisioned_concurrency_max                = 5
provisioned_concurrency_target_utilization = 0.7
enable_xray                                = true
manage_api_gateway_account                 = true
log_retention_days                         = 30
lambda_duration_threshold_ms               = 5000
api_5xx_threshold                          = 5
api_4xx_threshold                          = 50
api_latency_threshold_ms                   = 3000
api_integration_latency_threshold_ms       = 2500
api_name                                   = "sesEmailRestApi"
api_stage_name                             = "dev"
api_throttle_rate                          = 50
api_throttle_burst                         = 100
api_method_throttle_rate                   = 10
api_method_throttle_burst                  = 20
enable_api_cache                           = false
api_cache_size_gb                          = "0.5"
api_cache_ttl_seconds                      = 300
